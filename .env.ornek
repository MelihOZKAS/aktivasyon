# Kopyala: cp .env.ornek .env
DEBUG=True
SECRET_KEY=buraya-uzun-ve-rastgele-bir-anahtar-yaz
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Yerel geliştirme için SQLite yeter:
DATABASE_URL=sqlite:///db-dev.sqlite3

# Sunucuda PostgreSQL:
# DATABASE_URL=postgres://kullanici:parola@postgresfadil:5434/fadil_db
# POSTGRES_USER=kullanici
# POSTGRES_PASSWORD=parola
# POSTGRES_DB=fadil_db

# Telegram bildirimleri (opsiyonel). Tanımlı değilse bildirim gönderilmez.
# TELEGRAM_BOT_TOKEN=BotFather'dan aldığınız anahtar
# TELEGRAM_SOHBET_ID=@grup_kullanici_adi   ya da  -1001234567890
# Hata ayıklarken eşzamanlı göndermek için:
# TELEGRAM_ARKA_PLAN=False
